describe("Metro.Live.Socket") do
  it("routes an event by the first word of its name") do
    Assert.equal(Metro.Live.Socket.named(Metro.Live.Socket.decoded("event=bot-create&name=x")), "bot-create")
    Assert.equal(Metro.Live.Socket.resource("bot-create"), "bot")
    Assert.equal(Metro.Live.Socket.resource("bot-operators-set"), "bot")
    Assert.equal(Metro.Live.Socket.resource("typing"), "typing")
    Assert.equal(Metro.Live.Socket.resource(""), "")
  end

  it("answers a step with its next state, and whether others should ask again") do
    Assert.equal(Metro.Live.Socket.unchanged(1), (1, false))
    Assert.equal(Metro.Live.Socket.changed("tab"), ("tab", true))
  end

  it("reads an event's fields out of form-encoded text") do
    let entries = Metro.Live.Socket.decoded("event=save&name=Home+mortgage&notes=")
    Assert.equal(Metro.Live.Socket.field(entries, "event"), "save")
    Assert.equal(Metro.Live.Socket.field(entries, "name"), "Home mortgage")
    Assert.equal(Metro.Live.Socket.field(entries, "notes"), "")
    Assert.equal(Metro.Live.Socket.field(entries, "missing"), "")
    Assert.equal(Metro.Live.Socket.typed(Metro.Live.Socket.decoded("name=++Home+"), "name"), "Home")
  end

  it("reads every value of a field sent more than once") do
    let entries = Metro.Live.Socket.decoded("event=pick&person=u1&person=u2&note=")
    Assert.equal(Metro.Live.Socket.repeated(entries, "person"), ["u1", "u2"])
    Assert.equal(Metro.Live.Socket.repeated(entries, "note"), [""])
    Assert.equal(Metro.Live.Socket.repeated(entries, "missing"), [])
  end
end

describe("Metro.Live.Client") do
  it("carries the browser script inside the program") do
    Assert.truthy(Metro.Live.Client.script.contains?("new WebSocket"))
    Assert.truthy(Metro.Live.Client.script.contains?("patchChildren"))
  end
end

describe("Metro.Live.Router") do
  it("finds the handler for an event by the first word of its name") do
    let events = Metro.Live.Router.define do
      Metro.Live.Router.on(["bot"]) { |name, count| count + 1 }
      Metro.Live.Router.on(["team", "group"]) { |name, count| count + name.count }
    end
    let ask = do |name|
      Metro.Live.Router.answering(events, name).map { |answer| answer(name, 4) }.or(0)
    end
    Assert.equal(ask("bot-create"), 5)
    Assert.equal(ask("group-new"), 13)
    Assert.equal(ask("cancel"), 0)
  end

  it("hands a live route's socket handler its events") do
    let events = Metro.Live.Router.define do
      Metro.Live.Router.on(["bot"]) { |name, count| count }
    end
    let entry = Metro.Router.live "/live", events do |request, socket, routed|
      Void
    end
    match entry do
      Metro.Router.LiveEntry { path, handler } => Assert.equal(path, "/live")
      _ => Assert.truthy(false)
    end
  end
end

describe("Metro.Live.Presence") do
  it("counts somebody online until the last of their pages closes") do
    let board = Process.spawn(Metro.Live.Presence.Presence {})
    Assert.equal(Metro.Live.Presence.online(board), [])
    Metro.Live.Presence.arrived(board, "u1", "one")
    Metro.Live.Presence.arrived(board, "u1", "two")
    Assert.equal(Metro.Live.Presence.online(board), ["u1"])
    Metro.Live.Presence.departed(board, "u1", "one")
    Assert.equal(Metro.Live.Presence.online(board), ["u1"])
    Metro.Live.Presence.departed(board, "u1", "two")
    Assert.equal(Metro.Live.Presence.online(board), [])
  end

  it("knows anybody by whatever they are called, spaces and all") do
    let board = Process.spawn(Metro.Live.Presence.Presence {})
    Metro.Live.Presence.arrived(board, "Ada Lovelace", "s1")
    Assert.equal(Metro.Live.Presence.online(board), ["Ada Lovelace"])
  end
end

