describe("Metro.Console") do
  it("finds the source roots Tey would: the application's, overrides, then the cache") do
    let root = "console_spec_${Metro.Clock.milliseconds()}"
    FS.Directory.create(root)
    FS.File.write("${root}/package.kex", "package \"app\" do\n  sources([\"app\"])\nend\n")
    FS.File.write("${root}/package.local.kex", "local(\"metro\", path: \"../metro\")\n")
    let lock = {
      packages: {
        app: { source: "workspace", path: "." },
        metro: { source: "git", git: "https://example.com/metro", commit: "abc" },
        tool: { source: "git", git: "https://example.com/tool", commit: "def", subdir: "tool" }
      }
    }
    FS.File.write("${root}/tey.lock", JSON.stringify(lock))
    with ENV = Mock.Env { vars: {"TEY_CACHE": "/cache"} } do
      Assert.equal(Metro.Console.sourceRoots(root), Ok([
        root,
        "metro/src",
        "/cache/src/${Digest.sha256("https://example.com/tool")}/def/tool/src"
      ]))
    end
    Assert.truthy(Metro.Console.sourceRoots("${root}/nowhere").error?)
    FS.Directory.deleteAll(root)
  end
end
