using Metro.Generators.App, only: [Sources]

describe("Metro.Generators.App") do
  let files = Metro.Generators.App.files("chat_room", Sources {})
  let written(path: String) -> String do
    match files.find { |file| match file do (name, _) => name == path end } do
      Just((_, text)) => text
      None => ""
    end
  end

  it("takes names a package, a cookie and a database can have") do
    Assert.truthy(Metro.Generators.App.valid?("chat_room"))
    Assert.falsy(Metro.Generators.App.valid?("Chat"))
    Assert.falsy(Metro.Generators.App.valid?("9lives"))
  end

  it("writes a Dockerfile and a compose file that run the app on PostgreSQL") do
    Assert.truthy(written("Dockerfile").contains?("# ChatRoom in a container"))
    Assert.truthy(written("Dockerfile").contains?("odbc-postgresql"))
    Assert.truthy(written(".dockerignore").contains?("package.local.kex"))
    let compose = written("docker-compose.yml")
    Assert.truthy(compose.contains?("image: postgres:17"))
    Assert.truthy(compose.contains?("POSTGRES_DB: chat_room"))
    Assert.truthy(compose.contains?("Database=chat_room;Uid=chat_room;Pwd="))
    Assert.truthy(compose.contains?("POSTGRES_PASSWORD:-chat_room}"))
  end

  it("fills the application's name in, and leaves a generated template's own tags alone") do
    Assert.equal(files.count, 37)
    Assert.truthy(written("package.kex").startsWith?("package \"chat_room\" do"))
    Assert.truthy(written("package.kex").contains?("tey(\"harmat\", git: \"https://github.com/kexhq/harmat\""))
    Assert.truthy(written("README.md").startsWith?("# ChatRoom"))
    # A page of the application is a template itself: its front matter and
    # its tags are the application's, not the generator's.
    let page = written("app/views/home/index.html.ket")
    Assert.truthy(page.startsWith?("---\nparams: ["))
    Assert.truthy(page.contains?("<%= ") && !page.contains?("<%%"))
    # The database is installed around the routes, not handed to them.
    Assert.truthy(written("main.kex").contains?("with Harmat.Connection = DB.Store.StoreConnection { store: store } do"))
    Assert.truthy(written("config/routes.kex").contains?("foul routes(hub) do"))
    Assert.truthy(written("db/repositories/users.kex").contains?("Database.select().from(DB.Schema.Users)"))
    # Nothing of the generator's own is left in what it writes.
    Assert.falsy(files.any? { |file| match file do (_, text) => text.contains?("<%= app %>") || text.contains?("<%= title %>") end })
  end
end
