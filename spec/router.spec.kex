using Metro.Connection, only: [Connection, Plug, plug]
using Metro.Router, only: [Resource, pipeline, scope, get, post, live, static, resources]

module Things do
  foul index(connection: Connection) -> Connection = connection.plain("all things")
  foul show(connection: Connection) -> Connection = connection.plain("thing ${connection.param("id").or("?")}")
  foul create(connection: Connection) -> Connection = connection.json(201, {"made": connection.param("name").or("")})

  let resource = Resource { index: Just(~index), show: Just(~show), create: Just(~create) }
end

# Lets a request with the right header through, noting who it is.
let admitted = plug do |connection|
  match connection.header("X-User") do
    Just(name) => connection.assign(:user, name)
    None => connection.plain(401, "Who are you?")
  end
end

let stamped = plug do |connection| connection.withHeader("X-Stamped", "yes") end

let routes = Metro.Router.define do
  pipeline(:marked, [stamped])
  pipeline(:members, [admitted])

  get "/" do |connection| connection.html("<h1>home</h1>") end
  get "/silent" do |connection| connection end
  get "/broken" do |connection| connection.plain(Error("it broke").try) end

  scope "/app", via: [:marked, :members] do
    get "/me" do |connection|
      let name : String = connection.assigned(:user).try
      connection.plain("you are ${name}")
    end
    post "/go" do |connection| connection.redirect("/app/me") end
    resources("/things", Things.resource)
    get("/listed", ~Things.index)

    scope "/deep", via: [:marked] do
      get "/:first/and/:second" do |connection| connection.plain("${connection.param("first").or("")}+${connection.param("second").or("")}") end
    end
  end

  scope "/nowhere", via: [:missing] do
    get "/" do |connection| connection.plain("unreachable") end
  end

  static("spec")
end

foul answer(connection: Connection) -> (Integer, String) do
  let answered = routes.call(connection)
  (answered.code, answered.payload.to(String).or(""))
end

describe("Metro.Router") do
  it("lists every route with its whole path, in order") do
    Assert.equal(routes.listing, [
      "GET /", "GET /silent", "GET /broken", "GET /app/me", "POST /app/go",
      "GET /app/things", "POST /app/things", "GET /app/things/:id", "GET /app/listed",
      "GET /app/deep/:first/and/:second", "GET /nowhere", "GET /*path"
    ])
  end

  it("answers a route with its action") do
    Assert.equal(answer(Metro.Connection.asked("GET", "/")), (200, "<h1>home</h1>"))
    Assert.equal(routes.call(Metro.Connection.asked("GET", "/")).outgoing.get("Content-Type"), Just("text/html; charset=utf-8"))
  end

  it("runs a scope's pipelines first, and stops at a plug that answers") do
    Assert.equal(answer(Metro.Connection.asked("GET", "/app/me")), (401, "Who are you?"))
    let admittedIn = routes.call(Metro.Connection.asked("GET", "/app/me", [("X-User", "ada")], ""))
    Assert.equal(admittedIn.payload.to(String).or(""), "you are ada")
    Assert.equal(admittedIn.outgoing.get("X-Stamped"), Just("yes"))
    Assert.equal(routes.call(Metro.Connection.asked("GET", "/")).outgoing.get("X-Stamped"), None)
  end

  it("reads params from the path, the query, a form and JSON") do
    Assert.equal(answer(Metro.Connection.asked("GET", "/app/deep/a/and/b", [("X-User", "ada")], "")), (200, "a+b"))
    Assert.equal(answer(Metro.Connection.asked("GET", "/app/things/42", [("X-User", "ada")], "")), (200, "thing 42"))
    Assert.equal(answer(Metro.Connection.asked("POST", "/app/things", [("X-User", "ada")], "name=a+b")), (201, "{\"made\":\"a b\"}"))
    Assert.equal(answer(Metro.Connection.asked("POST", "/app/things", [("X-User", "ada")], "{\"name\": \"json\"}")), (201, "{\"made\":\"json\"}"))
    Assert.equal(Metro.Connection.asked("GET", "/x?q=one+two&r").query("q"), Just("one two"))
  end

  it("redirects") do
    let gone = routes.call(Metro.Connection.asked("POST", "/app/go", [("X-User", "ada")], ""))
    Assert.equal(gone.code, 303)
    Assert.equal(gone.outgoing.get("Location"), Just("/app/me"))
  end

  it("takes a named function as an action") do
    Assert.equal(answer(Metro.Connection.asked("GET", "/app/listed", [("X-User", "ada")], "")), (200, "all things"))
  end

  it("only offers the actions a resource has") do
    Assert.equal(answer(Metro.Connection.asked("GET", "/app/things", [("X-User", "ada")], "")), (200, "all things"))
    Assert.equal(routes.call(Metro.Connection.asked("DELETE", "/app/things/1", [("X-User", "ada")], "")).code, 404)
  end

  it("answers 500 for an action that raises, writes nothing, or names no pipeline") do
    Assert.equal(routes.call(Metro.Connection.asked("GET", "/broken")).code, 500)
    Assert.equal(routes.call(Metro.Connection.asked("GET", "/silent")).code, 500)
    Assert.equal(routes.call(Metro.Connection.asked("GET", "/nowhere")).code, 500)
  end

  it("serves files of a folder, and nothing outside it") do
    let served = routes.call(Metro.Connection.asked("GET", "/router.spec.kex"))
    Assert.equal(served.code, 200)
    Assert.truthy(served.payload.to(String).or("").contains?("describe(\"Metro.Router\")"))
    Assert.equal(routes.call(Metro.Connection.asked("GET", "/../package.kex")).code, 404)
    Assert.equal(routes.call(Metro.Connection.asked("GET", "/no-such-file")).code, 404)
  end
end

describe("Metro.Plugs") do
  it("refuses a post from another site and lets this site's through") do
    let guarded = Metro.Router.define do
      pipeline(:browser, [Metro.Plugs.sameOrigin])
      scope "/", via: [:browser] do
        post "/act" do |connection| connection.plain("done") end
        get "/see" do |connection| connection.plain("seen") end
      end
    end
    Assert.equal(guarded.call(Metro.Connection.asked("POST", "/act", [("Origin", "http://evil.example"), ("Host", "slick.test")], "")).code, 403)
    Assert.equal(guarded.call(Metro.Connection.asked("POST", "/act", [("Origin", "http://slick.test"), ("Host", "slick.test")], "")).code, 200)
    Assert.equal(guarded.call(Metro.Connection.asked("GET", "/see", [("Origin", "http://evil.example"), ("Host", "slick.test")], "")).code, 200)
  end
end
