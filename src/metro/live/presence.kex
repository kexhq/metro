# What people are in the middle of, for a while: "is typing", "Deploying".
#
# A note belongs to a member of a topic — a person in a conversation — and
# lapses by itself. Nothing here is stored: it lives in a `serving` process,
# and a restart forgets it, which is what a note that says "right now" should
# do.
#
#   let board = Process.spawn(Metro.Live.Presence.Presence {})
#   board.noted("general", user.id, "is typing", now + 6000)
#   Metro.Live.Presence.standing(board, "general", now)   # => [Note]
#
# Times are milliseconds since 1970, and the caller's: the board has no clock.
#
# Who has a page open is a topic of its own (`arrived`, `departed`,
# `online`): one member per page, so that closing one of somebody's two tabs
# does not make them look gone.
module Metro.Live.Presence

record Note do
  topic : String
  member : String
  # What they are doing, in words; "" when the topic's own default says it.
  saying : String
  # When it stops being true.
  lapses : Integer
end

record Presence do
  notes : [Note] = []
end

serving Presence do
  # Says what a member of a topic is doing until `lapses`, in place of
  # whatever was said for them before.
  slot noted(topic: String, member: String, text: String, lapses: Integer) -> Void do
    new.notes = @notes.reject { |note| note.topic == topic && note.member == member } + [Note { topic: topic, member: member, saying: text, lapses: lapses }]
    return new
  end

  # Takes a member's note back before it lapses.
  slot lifted(topic: String, member: String) -> Void do
    new.notes = @notes.reject { |note| note.topic == topic && note.member == member }
    return new
  end

  # The notes of a topic that still stand at `now`. Lapsed ones, of every
  # topic, are forgotten on the way.
  slot current(topic: String, now: Integer) -> Reply<[Note]> do
    new.notes = @notes.filter { |note| note.lapses > now }
    return { new, reply: new.notes.filter { |note| note.topic == topic } }
  end
end

# The notes of a topic that still stand; none when the board does not answer.
standing : Server<Presence> -> String -> Integer -> [Note]
foul standing(board, topic, now) do
  match board.current(topic, now) do
    Ok(notes) => return notes
    Error(_) => return []
  end
end

# The topic of who has a page open. A member there is "<seat> <who>": the
# seat — a page's own token, without spaces — tells one of somebody's pages
# from another, and `who` may be anything.
let ONLINE = "online"

# How long a page counts as open without being said again: a day.
let OPEN_FOR = 86400000

# Somebody has a page open: `seat` is that page's own.
arrived : Server<Presence> -> String -> String -> Void
foul arrived(board, who, seat) do
  board.noted(ONLINE, "${seat} ${who}", "", Metro.Clock.milliseconds() + OPEN_FOR)
end

# One of somebody's pages has closed.
departed : Server<Presence> -> String -> String -> Void
foul departed(board, who, seat) do
  board.lifted(ONLINE, "${seat} ${who}")
end

# Who has a page open, each once however many they have.
online : Server<Presence> -> [String]
foul online(board) = standing(board, ONLINE, Metro.Clock.milliseconds())
  .map { |note| note.member.split(" ").drop(1).join(" ") }
  .uniq

