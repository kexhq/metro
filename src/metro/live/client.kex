# The browser half of a live page, and the route that serves it.
#
# The script (live.js, beside this file) opens the WebSocket, turns clicks,
# typing and form submissions into events, and patches the markup the server
# sends back into the page. A page opts in with three things:
#
#   <main id="app">…the live region…</main>           what gets patched
#   <span id="status" data-state="connecting"></span>  where the request state shows
#   <script src="/metro/live.js"></script>
#
# and the server answers the WebSocket at `/live` with `Metro.Live.Socket`.
module Metro.Live.Client

using Metro.WebRequest, only: [WebRequest]

# Where the script is served.
let PATH = "/metro/live.js"

# The script itself, embedded in the program when it is built: an application
# has no file to copy into its own public/ folder.
script : String
let script = Kex.embed("live.js")

# The route to put in a router: `Metro.Live.Client.route()`.
route : Metro.Router.Entry
let route = Metro.Router.get(PATH, do |request|
  request.withHeader("Content-Type", "text/javascript; charset=utf-8").plain(Metro.Live.Client.script)
end)

# The script's address with a mark of what is in it, so a browser that has
# kept an old copy asks again when it changes: `<script src="…">`.
address : String
let address = "${PATH}?v=${Digest.sha256(Metro.Live.Client.script).take(12)}"
