# Metro.Environment — where this process is running, read the same way by
# every Metro application.
#
#   METRO_ENV   development (the default), test or production; test is the
#               default under a spec, which Kex marks with KEX_TEST
#   PORT        the port the application listens on; 4000 unless set
#   HOST        the address it binds; 127.0.0.1 unless set
#
#   match Metro.Environment.current() do
#     Ok(Production) => …
#     Ok(environment) => IO.printLine("running in ${environment.label}")
#     Error(reason) => …
#   end
#
# An application does not name an environment variable of its own for this:
# what differs between environments — which database, say — is decided from
# `current`, in the application's config/.
module Metro.Environment

type Environment = Development | Test | Production

# The variable every Metro application's environment is chosen with.
let VARIABLE = "METRO_ENV"

# The environment METRO_ENV names. When it is not set: `Test` under a spec
# (`kex` sets KEX_TEST for one, so `tey test` never reaches the development
# database), `Development` otherwise. A name that is none of the three is an
# error, not a guess: a misspelt `production` must not quietly run as
# development.
current : Result<Environment, String>
foul current = named(ENV.get(VARIABLE).or(ENV.get("KEX_TEST").set? then "test" else "development"))

private do
  named : String -> Result<Environment, String>
  let named("development") = Ok(Development)
  let named("test") = Ok(Test)
  let named("production") = Ok(Production)
  let named(other) = Error("${VARIABLE} must be development, test or production, not ${other}")
end

# The port to listen on.
port : Integer
foul port = ENV.get("PORT").flatMap { |text| text.to(Integer) }.or(4000)

# The address to bind.
host : String
foul host = ENV.get("HOST").or("127.0.0.1")

make Environment do
  # The environment as METRO_ENV spells it.
  label :> String
  let label(@Development) = "development"
  let label(@Test) = "test"
  let label(@Production) = "production"
end
