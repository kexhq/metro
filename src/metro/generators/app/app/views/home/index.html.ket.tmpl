---
params: [email: String, presses: String, notice: String]
---
<% if !notice.empty? %>
<p class="notice" role="status"><%= notice %>
  <button type="button" class="quiet" data-event="dismiss" aria-label="Dismiss">×</button>
</p>
<% end %>
<section class="summary">
  <article class="total">
    <h2>Signed in as</h2>
    <p class="net"><%= email %></p>
    <dl>
      <div><dt>Presses in this tab</dt><dd><%= presses %></dd></div>
    </dl>
  </article>
</section>
<p>
  <button type="button" class="primary" data-event="press">Press</button>
  <button type="button" data-event="reset">Reset</button>
</p>
<p class="empty">This page is rendered on the server and kept live over a WebSocket. Its events are in app/live/home.kex and its markup in app/views/home/.</p>
