---
params: [app: String, title: String]
---
# The sign-in and registration pages: plain forms, posted the ordinary way.
# Nothing here is live — there is no session to hold a WebSocket open for yet.
module App.Views.Auth

let frame = Template.html(Kex.embed("layouts/auth.html.ket"))
let signinForm = Template.html(Kex.embed("auth/signin.html.ket"))
let registerForm = Template.html(Kex.embed("auth/register.html.ket"))

# The sign-in page. `email` is what was typed last time, so a wrong password
# does not cost retyping it; the password is never sent back.
signin : String -> [String] -> String
let signin(email, problems) = frame("Sign in", signinForm(email, problems))

register : String -> [String] -> String
let register(email, problems) do
  frame("Create your account", registerForm(email, problems, "${App.Forms.Credentials.SHORTEST_PASSWORD}"))
end
