---
params: [heading: String, body: String]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= heading %> · __App__</title>
    <link rel="stylesheet" href="/app.css">
  </head>
  <body>
    <main class="auth">
      <span class="brand">__App__</span>
      <h1><%= heading %></h1>
      <%== body %>
    </main>
  </body>
</html>
