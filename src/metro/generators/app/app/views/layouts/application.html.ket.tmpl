---
params: [email: String, live: String]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>__App__</title>
    <link rel="stylesheet" href="/app.css">
  </head>
  <body>
    <header class="top">
      <span class="brand">__App__</span>
      <span class="who">
        <span id="status" class="status" data-state="connecting">Connecting…</span>
        <span class="email"><%= email %></span>
        <form method="post" action="/signout"><button type="submit" class="quiet">Sign out</button></form>
      </span>
    </header>
    <main id="app"><%== live %></main>
    <script src="/metro/live.js"></script>
  </body>
</html>
