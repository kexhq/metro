---
params: [app: String, title: String]
---
# <%= title %>
#
#   tey server      http://localhost:4000 — migrates first, then serves
#   tey db:migrate  run the migrations this database has not run
#   tey db:rollback undo the newest migration; `tey db:rollback 3` undoes three
#
# METRO_ENV says where this is running, and PORT and HOST move the listener
# (`Metro.Environment`); the environment and DATABASE_DSN choose the database
# (config/database.kex).

foul failed(reason: String) -> Void do
  IO.printError("<%= app %>: ${reason}")
  System.exit(1)
end

# Runs pending migrations and says which; whether it worked.
foul upToDate(store: Server<DB.Store.Store>) -> Bool do
  match DB.Store.migrate(store) do
    Ok(names) => do
      names.each { |name| IO.printLine("migrated ${name}") }
      return true
    end
    Error(reason) => do
      failed(reason)
      return false
    end
  end
end

foul undone(store: Server<DB.Store.Store>, count: Integer) -> Void do
  match DB.Store.rollback(store, count) do
    Ok([]) => IO.printLine("Nothing to roll back.")
    Ok(names) => names.each { |name| IO.printLine("rolled back ${name}") }
    Error(reason) => failed(reason)
  end
end

foul served(store: Server<DB.Store.Store>) -> Void do
  let port = Metro.Environment.port()
  let bindHost = Metro.Environment.host()
  let environment = Metro.Environment.current().map { |running| running.label }.or("")
  IO.printLine("<%= title %> (${environment}) is on http://${bindHost == "0.0.0.0" then "localhost" else bindHost}:${port}")
  # Everything that serves is made in here, the routes included: this is
  # where the store becomes the database every query reaches.
  with Harmat.Connection = DB.Store.StoreConnection { store: store } do
    let site = Config.Routes.routes(Process.spawn(Metro.Live.Hub.Hub {}))
    site.start(bindHost, port).try
  end
end

foul commanded(store: Server<DB.Store.Store>, args: [String]) -> Void do
  match args.first.or("server") do
    "server" => upToDate(store) then served(store) else ()
    "migrate" => upToDate(store) then IO.printLine("The database is up to date.") else ()
    "rollback" => undone(store, args.second.flatMap { |text| text.to(Integer) }.or(1))
    other => failed("unknown command ${other}; expected server, migrate or rollback")
  end
end

main(args) do
  match (Metro.Environment.current(), Config.Database.dsn) do
    (Error(reason), _) => failed(reason)
    (_, Error(reason)) => failed(reason)
    (_, Ok(dsn)) => match DB.Store.started(dsn) do
      Error(reason) => failed(reason)
      Ok(store) => commanded(store, args)
    end
  end
end
