---
params: [app: String, title: String]
---
using App.Live.Tab, only: [Tab]
using App.Models.User, only: [User]

# The application as it is linked for serving: the routes are built, so
# the router and Net.HTTP are part of the program, and every repository method
# is called through the sign-in flow. Some names only stop resolving once the
# HTTP stack is linked in (kexhq/kex#451); this spec is the tripwire.
describe("<%= title %>") do
  it("has one migration history that matches db/schema") do
    Assert.equal(Harmat.Table.drift(DB.Schema.tables, DB.Migrations.all), [])
    Assert.equal(Harmat.Migration.irreversible(DB.Migrations.all), [])
    Assert.equal(Harmat.Migration.head(DB.Migrations.all), Ok("create_sessions"))
  end

  it("registers, signs in and out") do
    let file = "db/spec_${Metro.Clock.milliseconds()}.sqlite3"
    let store = DB.Store.started(Config.Database.sqlite(file)).try
    DB.Store.migrate(store).try
    with Harmat.Connection = DB.Store.StoreConnection { store: store } do
      let site = Config.Routes.routes(Process.spawn(Metro.Live.Hub.Hub {}))
      Assert.truthy(site.table.count > 0)
      # Over HTTP: nobody signed in is sent to sign in, and can.
      Assert.equal(site.call(Metro.WebRequest.asked("GET", "/")).outgoing.get("Location"), Just("/signin"))
      Assert.equal(site.call(Metro.WebRequest.asked("GET", "/signin")).code, 200)
      Assert.equal(site.call(Metro.WebRequest.asked("POST", "/signin", [("Host", "app.test"), ("Origin", "http://evil.example")], "")).code, 403)
      let here = [("Host", "app.test"), ("Origin", "http://app.test")]
      let registered = site.call(Metro.WebRequest.asked("POST", "/register", here, "email=bob%40example.com&password=correct+horse+battery"))
      Assert.equal(registered.outgoing.get("Location"), Just("/"))

      Assert.truthy(App.Services.Authentication.register("ada", "short").error?)
      let token = App.Services.Authentication.register("Ada@Example.com", "correct horse battery").try
      let ada : User = App.Services.Authentication.current(Just(token)).try
      Assert.equal(ada.email, "ada@example.com")
      Assert.truthy(App.Services.Authentication.register("ada@example.com", "correct horse battery").error?)
      Assert.truthy(App.Services.Authentication.signIn("ada@example.com", "wrong password!").error?)

      let again = App.Services.Authentication.signIn("ada@example.com", "correct horse battery").try
      App.Services.Authentication.signOut(Just(again))
      Assert.equal(App.Services.Authentication.current(Just(again)), None)
      Assert.truthy(App.Services.Authentication.current(Just(token)).set?)
    end
    FS.File.delete(file)
  end

  it("renders the home page and steps it") do
    let user = User { id: "u1", email: "ada@example.com" }
    Assert.truthy(App.Live.Home.markup(user, Tab {}).contains?("ada@example.com"))
    let (pressed, changed?) = App.Live.Home.handled(Tab {}, [("event", Just("press"))])
    Assert.equal(pressed.presses, 1)
    Assert.falsy(changed?)
  end
end
