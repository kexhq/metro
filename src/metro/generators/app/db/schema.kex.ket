---
params: [app: String, title: String]
---
# Every table this application declares: what `Harmat.Table.drift` holds the
# migrations against. One file each in db/schema.
module DB.Schema

using Harmat.Table, only: [Definition]

# Each table under the name of its own module, so that a query reads
# `.from(DB.Schema.Users)` and a condition `DB.Schema.Users.email.eq(email)`:
# the name alone is the table, and a name after it is one of its columns.
let Users = DB.Schema.Users.definition
let Sessions = DB.Schema.Sessions.definition

tables : [Definition]
let tables = [
  DB.Schema.Users,
  DB.Schema.Sessions
]
