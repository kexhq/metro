---
params: [app: String, title: String]
---
# The process that owns the database connection.
#
# Erlang's `odbc` only answers the process that connected, so the connection
# cannot be handed around: it lives here, in a `serving` process, and every
# statement is run by it. That also serializes every read and write, which is
# enough concurrency control to start with.
#
# Nothing outside db/ calls a slot. Queries reach the database through
# `Harmat.Connection`, which `StoreConnection` — this process, seen from any
# other — is installed as wherever requests are served (main.kex).
module DB.Store

using Harmat.Odbc, only: [Statement]

record Store do
  connection : Any = :closed
end

# Where script/setup-odbc.sh from Harmat puts an ODBC port program, for an
# Erlang that was packaged without one.
let ODBC = "db/odbc"

serving Store do
  # Connects — once the migration history is known to be sound: one head,
  # and migrations that produce exactly the tables db/schema declares.
  foul slot opened(dsn: String) -> Reply<Result<String, String>> do
    match sound() do
      Error(reason) => return { reply: Error(reason) }
      Ok(head) => do
        Harmat.Odbc.sideload(ODBC)
        match Harmat.Odbc.connect(dsn) do
          Error(reason) => return { reply: Error(reason) }
          Ok(connection) => do
            new.connection = connection
            return { new, reply: Ok(head) }
          end
        end
      end
    end
  end

  # Runs the migrations this database has not run. Their names.
  foul slot migrated -> Reply<Result<[String], String>> do
    return { reply: Harmat.Migration.migrate(@connection, DB.Migrations.all) }
  end

  # Undoes the newest `count` migrations. Their names, newest first.
  foul slot rolledBack(count: Integer) -> Reply<Result<[String], String>> do
    return { reply: Harmat.Migration.rollback(@connection, DB.Migrations.all, count) }
  end

  foul slot ran(statement: Statement) -> Reply<Result<Integer, String>> do
    return { reply: Harmat.Odbc.execute(@connection, statement) }
  end

  foul slot ranMany(statement: Statement) -> Reply<Result<Integer, String>> do
    return { reply: Harmat.Odbc.executeMany(@connection, statement) }
  end

  foul slot asked(statement: Statement) -> Reply<Result<[[String]], String>> do
    return { reply: Harmat.Odbc.query(@connection, statement) }
  end

  # Runs `work` as one transaction, here, on this process's connection:
  # nothing another process asks for is run until it is over.
  foul slot transacted(work: Block<Result<Any, String>>) -> Reply<Result<Any, String>> do
    return { reply: Harmat.Database.Direct { connection: @connection }.transaction(work) }
  end
end

# A running store, connected. Migrating is a separate step: see `migrate`.
started : String -> Result<Server<Store>, String>
foul started(dsn) do
  let store = Process.spawn(Store {})
  match store.opened(dsn, within: 30_000) do
    Ok(Ok(_)) => Ok(store)
    Ok(Error(reason)) => Error(reason)
    Error(reason) => Error("the store did not answer: ${reason}")
  end
end

# The store as queries use it, from any process:
#
#   with Harmat.Connection = StoreConnection { store: store } do … end
record StoreConnection do
  store : Server<Store>
end

# Inside a transaction a statement is already in the store's own process
# (`transacted`), on the connection the transaction is open on: it runs
# there, without asking the store — which is busy running the transaction.
make StoreConnection, implement: Harmat.Connection do
  foul run(statement: Harmat.Odbc.Statement) -> Result<Integer, String> do
    match Harmat.Database.ongoing() do
      Just(connection) => return Harmat.Odbc.executing(connection, statement)
      None => return flat(@store.ran(statement))
    end
  end

  foul runMany(statement: Harmat.Odbc.Statement) -> Result<Integer, String> do
    match Harmat.Database.ongoing() do
      Just(connection) => return Harmat.Odbc.executingMany(connection, statement)
      None => return flat(@store.ranMany(statement))
    end
  end

  foul ask(statement: Harmat.Odbc.Statement) -> Result<[[String]], String> do
    match Harmat.Database.ongoing() do
      Just(connection) => return Harmat.Odbc.querying(connection, statement)
      None => return flat(@store.asked(statement))
    end
  end

  foul transaction(work: Block<Result<Any, String>>) -> Result<Any, String> do
    return work() if Harmat.Database.ongoing().set?
    return flat(@store.transacted(work, within: 30_000))
  end
end

migrate : Server<Store> -> Result<[String], String>
foul migrate(store) = flat(store.migrated(within: 120_000))

rollback : Server<Store> -> Integer -> Result<[String], String>
foul rollback(store, count) = flat(store.rolledBack(count, within: 120_000))

private do
  # The head of the migration history, or what is wrong with it.
  sound : Result<String, String>
  let sound do
    let drift = Harmat.Table.drift(DB.Schema.tables, DB.Migrations.all)
    return Error("db/schema and db/migrate disagree: ${drift.join("; ")}") if !drift.empty?

    Harmat.Migration.head(DB.Migrations.all)
  end

  # A slot call fails twice over — the process, then the database. One error.
  let flat(answer: Result<Result<A, String>, CallError>) -> Result<A, String> do
    match answer do
      Ok(inner) => inner
      Error(reason) => Error("the store did not answer: ${reason}")
    end
  end
end
