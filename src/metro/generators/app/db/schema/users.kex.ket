# The `users` table. `password_hash` is a `Metro.Auth.Password` line, never a
# password.
module DB.Schema.Users

using Harmat.Table, as: Table
let definition = Table.define :users do |t|
  t.text(:id, primaryKey: true)
  t.text(:email)
  t.text(:password_hash)
  t.text(:created_at)
end

let id = definition.textColumn(:id)
let email = definition.textColumn(:email)
let passwordHash = definition.textColumn(:password_hash)
let createdAt = definition.textColumn(:created_at)
