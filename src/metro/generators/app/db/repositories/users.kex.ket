---
params: [app: String, title: String]
---
# The people who can sign in.
#
#   DB.Repositories.Users.credentials(email)
module DB.Repositories.Users

using Harmat.Database, as: Database
using App.Models.User, only: [User]

# Stores a new user. Fails when the email is taken: the table's unique
# index decides, so two registrations racing for one address cannot both win.
foul enroll(user: User, passwordHash: String) -> Result<User, String> do
  return Database.insert(DB.Schema.Users)
    .record(user, extra: {password_hash: passwordHash, created_at: "${DateTime.utcNow()}"})
    .run
    .map { |_| user }
end

# The user registered under an email, with their stored password line.
foul credentials(email: String) -> Result<(User, String)?, String> do
  match Database.findBy(DB.Schema.Users, {email: email}).try do
    None => return Ok(None)
    Just(row) => do
      let user = Database.decoded(row, User, {}).try
      return Ok(Just((user, row.get("password_hash").or(""))))
    end
  end
end

foul member(id: String) -> Result<User?, String> = Database.find(DB.Schema.Users, id, as: User)

# How many users there are.
foul headcount -> Result<Integer, String> = Database.select().from(DB.Schema.Users).count
