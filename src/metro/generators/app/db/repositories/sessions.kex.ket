---
params: [app: String, title: String]
---
# Who is signed in where. It only ever sees token digests.
#
#   SessionRepository { db: db }.holder(digest)
module DB.Repositories.Sessions

using Harmat.Db, only: [Db, eq]

record SessionRepository do
  db : Db
end

# Keep method names distinct from the other repositories' and away from
# common words like `remove`: such a name can be "Undefined method" in the
# served application though its spec passes (kexhq/kex#451).
make SessionRepository do
  foul admit(tokenDigest: String, userId: String, expiresAt: Integer) -> Result<Integer, String> do
    let row = {token_digest: tokenDigest, user_id: userId, expires_at: expiresAt, created_at: "${DateTime.utcNow()}"}
    return @db.insert(DB.Schema.Sessions.definition).values(row).run
  end

  # Whose session a digest is, and when it expires (seconds since 1970).
  foul holder(tokenDigest: String) -> Result<(String, Integer)?, String> do
    return @db.select().from(DB.Schema.Sessions.definition).where(eq(DB.Schema.Sessions.tokenDigest, tokenDigest)).first
      .map { |row| row.map { |found| (found.get("user_id").or(""), found.get("expires_at").or("").trim.to(Integer).or(0)) } }
  end

  foul revoke(tokenDigest: String) -> Result<Bool, String> do
    return @db.delete(DB.Schema.Sessions.definition).where(eq(DB.Schema.Sessions.tokenDigest, tokenDigest)).run.map { |count| count > 0 }
  end
end
