---
params: [app: String, title: String]
---
# <%= title %> in a container: the Kex toolchain, the application built in it, and
# the ODBC drivers it reaches a database through.
#
#   docker compose up --build      <%= title %> on http://localhost:4000, on PostgreSQL
#
# The image is the toolchain's own, so `tey` is what runs the application:
# `tey server` by default, and `docker compose run --rm app migrate` (or
# `rollback`) for the other commands.
#
# KEX_IMAGE is the toolchain: any image of Kex 0.4.0-rc.1 or newer. One built
# from a Kex checkout does (`docker build -f docker/Dockerfile -t kex:dev .`
# there, then KEX_IMAGE=kex:dev here).
ARG KEX_IMAGE=ghcr.io/kexhq/kex:rc
FROM ${KEX_IMAGE}

# unixODBC and its drivers: PostgreSQL's, which registers itself as
# "PostgreSQL Unicode", and SQLite's for a container run without a database
# beside it. git is how Tey fetches the dependencies package.kex names.
RUN apt-get update && apt-get install -y --no-install-recommends \
        unixodbc odbc-postgresql libsqliteodbc git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first, so that changing the application does not fetch them
# again. A dependency in a private repository needs a GitHub token to be
# fetched: it is handed over as a build secret (GITHUB_TOKEN, through
# docker-compose.yml), used for this one step, and is in no layer afterwards.
COPY package.kex tey.lock ./
RUN --mount=type=secret,id=github_token \
    token="$(cat /run/secrets/github_token 2>/dev/null || true)" \
    && if [ -n "$token" ]; then \
         git config --global url."https://x-access-token:${token}@github.com/".insteadOf "https://github.com/"; \
       fi \
    && tey install --approve-plugins \
    && rm -f "$HOME/.gitconfig"

COPY . .
RUN tey build

ENV METRO_ENV=production \
    HOST=0.0.0.0 \
    PORT=4000
EXPOSE 4000

ENTRYPOINT ["tey"]
CMD ["server"]
