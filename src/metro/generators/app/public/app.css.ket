---
params: [app: String, title: String]
---
:root {
  color-scheme: light dark;
  --page: #f6f5f1;
  --panel: #ffffff;
  --ink: #1d2327;
  --muted: #5f6b73;
  --line: #dedbd2;
  --accent: #1f6f5c;
  --accent-ink: #ffffff;
  --accent-soft: #e3f1ec;
  --owed: #a63d2f;
  --owed-soft: #f8e7e3;
  --warn-soft: #fbf1d5;
  --radius: 10px;
}

@media (prefers-color-scheme: dark) {
  :root {
    --page: #14181a;
    --panel: #1d2326;
    --ink: #e8ecee;
    --muted: #9aa7ae;
    --line: #2f383d;
    --accent: #5cc2a6;
    --accent-ink: #0d1f1a;
    --accent-soft: #1d332d;
    --owed: #ee8f80;
    --owed-soft: #3a2320;
    --warn-soft: #3a3320;
  }
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--page);
  color: var(--ink);
  font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif;
}

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 62rem;
  margin: 0 auto;
  padding: 1.25rem 1rem 0.25rem;
}

.brand { font-size: 1.35rem; font-weight: 700; letter-spacing: -0.01em; }

.status { font-size: 0.8rem; color: var(--muted); }
.status::before {
  content: "";
  display: inline-block;
  width: 0.55rem;
  height: 0.55rem;
  margin-right: 0.4rem;
  border-radius: 50%;
  background: var(--muted);
}
.status[data-state="live"]::before { background: var(--accent); }
.status[data-state="offline"]::before { background: var(--owed); }

main { max-width: 62rem; margin: 0 auto; padding: 0.75rem 1rem 4rem; }

h2 { margin: 0; font-size: 1.05rem; }

button {
  font: inherit;
  font-size: 0.9rem;
  padding: 0.4rem 0.8rem;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--panel);
  color: var(--ink);
  cursor: pointer;
}
button:hover { border-color: var(--muted); }
button:focus-visible, input:focus-visible, textarea:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 1px;
}
button.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
button.danger { background: var(--owed); border-color: var(--owed); color: var(--panel); font-weight: 600; }
button.quiet { border-color: transparent; background: transparent; color: var(--muted); }

.notice, .failure {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin: 0 0 1rem;
  padding: 0.6rem 0.9rem;
  border-radius: var(--radius);
}
.notice { background: var(--accent-soft); }
.failure { background: var(--owed-soft); color: var(--owed); }

.summary {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.total {
  padding: 1.1rem 1.25rem;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
}
.total h2 { font-size: 0.85rem; font-weight: 600; color: var(--muted); }
.total .currency { padding: 0.05rem 0.4rem; border-radius: 5px; background: var(--accent-soft); color: var(--accent); }
.total .net { margin: 0.2rem 0 0.7rem; font-size: 1.9rem; font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; white-space: nowrap; }
.total dl { margin: 0; }
.total dl div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.15rem 0; font-size: 0.9rem; }
.total dt { color: var(--muted); }
.total dd { margin: 0; font-variant-numeric: tabular-nums; white-space: nowrap; }

.empty { margin: 0; padding: 0.9rem 1rem; color: var(--muted); border: 1px dashed var(--line); border-radius: var(--radius); }

.kind { margin-top: 1.75rem; }
.kind-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.6rem; }

.holdings { list-style: none; margin: 0; padding: 0; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); }
.holding {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 0.25rem 1.25rem;
  padding: 0.8rem 1rem;
}
.holding + .holding { border-top: 1px solid var(--line); }
.what { min-width: 0; }
.where { margin-left: 0.5rem; font-size: 0.85rem; color: var(--muted); overflow-wrap: anywhere; }
.where:empty { display: none; }

.facts { list-style: none; margin: 0.15rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.1rem 0.9rem; font-size: 0.85rem; color: var(--muted); }
.facts:empty { display: none; }
.notes { margin: 0.25rem 0 0; font-size: 0.85rem; color: var(--muted); font-style: italic; overflow-wrap: anywhere; }

.worth { font-weight: 650; font-variant-numeric: tabular-nums; white-space: nowrap; text-align: right; }
.worth.owed { color: var(--owed); }
.actions { display: flex; align-items: center; gap: 0.35rem; white-space: nowrap; }
.confirm { font-size: 0.9rem; font-weight: 600; }

/* The add/edit form is a dialog over the page. The page behind it does not
   scroll while it is open. */
body:has(.backdrop) { overflow: hidden; }

.backdrop {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 6vh 1rem 1rem;
  overflow-y: auto;
  background: rgb(0 0 0 / 0.45);
}

.editor {
  width: min(46rem, 100%);
  padding: 1.25rem 1.4rem 1.4rem;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: 0 18px 50px rgb(0 0 0 / 0.3);
}
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 0.9rem 1rem; margin-top: 0.9rem; }
.field { display: flex; flex-direction: column; gap: 0.2rem; }
.field.wide { grid-column: 1 / -1; }
.label { font-size: 0.85rem; font-weight: 600; }
.required { margin-left: 0.15rem; color: var(--owed); }
.hint { font-size: 0.78rem; color: var(--muted); }
.problem { font-size: 0.8rem; color: var(--owed); }

input, textarea {
  width: 100%;
  font: inherit;
  padding: 0.45rem 0.6rem;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--page);
  color: var(--ink);
}
textarea { resize: vertical; }
.field.invalid input, .field.invalid textarea { border-color: var(--owed); }

.preview {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.3rem 1.25rem;
  margin-top: 1rem;
  padding: 0.7rem 0.9rem;
  border-radius: 8px;
  background: var(--accent-soft);
}
.preview-worth { font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
.preview .facts { margin: 0; color: var(--ink); }

.form-actions { display: flex; gap: 0.5rem; margin-top: 1rem; }

@media (max-width: 40rem) {
  .backdrop { padding: 0; }
  .editor { min-height: 100%; border-radius: 0; border: 0; }
  .holding { grid-template-columns: minmax(0, 1fr) auto; }
  .actions { grid-column: 1 / -1; }
  .total .net { font-size: 1.55rem; }
}

.who { display: flex; align-items: center; gap: 0.9rem; font-size: 0.85rem; color: var(--muted); }
.who form { margin: 0; }
.email { overflow-wrap: anywhere; }

.auth { max-width: 24rem; padding-top: 4rem; }
.auth h1 { margin: 0.4rem 0 1.2rem; font-size: 1.5rem; letter-spacing: -0.01em; }
.auth .failure { display: block; padding: 0.6rem 0.9rem 0.6rem 2rem; }
.credentials { display: flex; flex-direction: column; gap: 1rem; padding: 1.25rem; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); }
.credentials button { align-self: flex-start; }
.switch { margin-top: 1rem; font-size: 0.9rem; color: var(--muted); }
a { color: var(--accent); }

@media (max-width: 40rem) {
  .who .email { display: none; }
}
