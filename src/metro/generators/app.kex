# The `app` generator: the files of a new Metro application.
#
# A new app is the skeleton every Metro application shares — the Rails-style
# layout, the database store and migrations, registration and sign-in, one
# live page to start from, and a Dockerfile and docker-compose.yml that run
# it on PostgreSQL — with the application's name filled in. The templates
# are the `.ket` files under app/ beside this module, each named after the
# file it makes; they are embedded when Metro is built, so generating needs
# nothing on disk but Metro itself.
#
# This module only says what to write. Writing is the caller's: Tey's plugin
# host (generators/app.kex speaks its protocol) or, until Tey can run a
# generator, the stand-in command (generators/new.kex).
module Metro.Generators.App

# Where a new app's dependencies come from.
record Sources do
  harmat : String = "https://github.com/kexhq/harmat"
  harmatBranch : String = "database-migrations-repositories"
  metro : String = "https://github.com/akoskovacs/metro"
  metroBranch : String = "main"
end

# Whether a name can be an application's: lower-case letters, digits and
# underscores, starting with a letter — it becomes a package name and a
# cookie name.
valid? : String -> Bool
let valid?(name) do
  let allowed = name.chars.all? { |char| char.lower? || char.digit? || "${char}" == "_" }
  !name.empty? && allowed && name.chars.first.map { |char| char.lower? }.or(false)
end

# `chat_room` as a title: "ChatRoom".
titled : String -> String
let titled(name) = name.split("_").map { |part| part.capitalize }.join("")

# Every file of a new application named `name`, as (path, content).
files : String -> Sources -> [(String, String)]
let files(name, sources) do
  let title = titled(name)
  let manifest = Template.text(Kex.embed("app/package.kex.ket"))
  let written = templates().map { |template|
    match template do (path, render) => (path, render(name, title)) end
  }
  written + [("package.kex", manifest(name, title, sources.harmat, sources.harmatBranch, sources.metro, sources.metroBranch))]
end

private do
  # A file of a new application: where it goes, and the template it is
  # written from — a `.ket` beside this module, handed the application's
  # name as it is and as a title ("chat_room", "ChatRoom"). package.kex is
  # not among them: it is told where the dependencies come from as well.
  templates : [(String, String -> String -> String)]
  let templates = [
    (".dockerignore", Template.text(Kex.embed("app/.dockerignore.ket"))),
    (".gitignore", Template.text(Kex.embed("app/.gitignore.ket"))),
    ("Dockerfile", Template.text(Kex.embed("app/Dockerfile.ket"))),
    ("README.md", Template.text(Kex.embed("app/README.md.ket"))),
    ("app/controllers/accounts.kex", Template.text(Kex.embed("app/app/controllers/accounts.kex.ket"))),
    ("app/controllers/application.kex", Template.text(Kex.embed("app/app/controllers/application.kex.ket"))),
    ("app/controllers/home.kex", Template.text(Kex.embed("app/app/controllers/home.kex.ket"))),
    ("app/forms/credentials.kex", Template.text(Kex.embed("app/app/forms/credentials.kex.ket"))),
    ("app/live/home.kex", Template.text(Kex.embed("app/app/live/home.kex.ket"))),
    ("app/live/tab.kex", Template.text(Kex.embed("app/app/live/tab.kex.ket"))),
    ("app/models/user.kex", Template.text(Kex.embed("app/app/models/user.kex.ket"))),
    ("app/services/authentication.kex", Template.text(Kex.embed("app/app/services/authentication.kex.ket"))),
    ("app/views/auth.kex", Template.text(Kex.embed("app/app/views/auth.kex.ket"))),
    ("app/views/auth/register.html.ket", Template.text(Kex.embed("app/app/views/auth/register.html.ket.ket"))),
    ("app/views/auth/signin.html.ket", Template.text(Kex.embed("app/app/views/auth/signin.html.ket.ket"))),
    ("app/views/home.kex", Template.text(Kex.embed("app/app/views/home.kex.ket"))),
    ("app/views/home/index.html.ket", Template.text(Kex.embed("app/app/views/home/index.html.ket.ket"))),
    ("app/views/layouts/application.html.ket", Template.text(Kex.embed("app/app/views/layouts/application.html.ket.ket"))),
    ("app/views/layouts/auth.html.ket", Template.text(Kex.embed("app/app/views/layouts/auth.html.ket.ket"))),
    ("config/database.kex", Template.text(Kex.embed("app/config/database.kex.ket"))),
    ("config/routes.kex", Template.text(Kex.embed("app/config/routes.kex.ket"))),
    ("docker-compose.yml", Template.text(Kex.embed("app/docker-compose.yml.ket"))),
    ("db/migrate/N0001_create_users.kex", Template.text(Kex.embed("app/db/migrate/N0001_create_users.kex.ket"))),
    ("db/migrate/N0002_create_sessions.kex", Template.text(Kex.embed("app/db/migrate/N0002_create_sessions.kex.ket"))),
    ("db/migrations.kex", Template.text(Kex.embed("app/db/migrations.kex.ket"))),
    ("db/repositories/sessions.kex", Template.text(Kex.embed("app/db/repositories/sessions.kex.ket"))),
    ("db/repositories/users.kex", Template.text(Kex.embed("app/db/repositories/users.kex.ket"))),
    ("db/schema.kex", Template.text(Kex.embed("app/db/schema.kex.ket"))),
    ("db/schema/sessions.kex", Template.text(Kex.embed("app/db/schema/sessions.kex.ket"))),
    ("db/schema/users.kex", Template.text(Kex.embed("app/db/schema/users.kex.ket"))),
    ("db/store.kex", Template.text(Kex.embed("app/db/store.kex.ket"))),
    ("main.kex", Template.text(Kex.embed("app/main.kex.ket"))),
    ("public/app.css", Template.text(Kex.embed("app/public/app.css.ket"))),
    ("script/setup-odbc.sh", Template.text(Kex.embed("app/script/setup-odbc.sh.ket"))),
    ("script/setup.sh", Template.text(Kex.embed("app/script/setup.sh.ket"))),
    ("spec/app.spec.kex", Template.text(Kex.embed("app/spec/app.spec.kex.ket")))
  ]
end
