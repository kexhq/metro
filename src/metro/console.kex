# Metro.Console — the application in Kex's REPL, as `rails console` is:
# its modules and its dependencies' in reach, and whatever it installs to
# run — a database connection, a logger — already in place.
#
#   tey console
#   kex(beam)> DB.Repositories.Users.maintained(id)
#     users (0.7ms)  SELECT … FROM users WHERE owner_organization_id = ?
#   => Ok([…]) : Result<[App.Models.User.User], String>
#
# An application gives it the lines to boot with, each entered as if typed
# before the first prompt; `/with` keeps a capability installed for the
# rest of the session:
#
#   Metro.Console.opened([
#     "/with Harmat.Logger = Config.Logging.queries()",
#     "/with Harmat.Connection = DB.Store.StoreConnection { store: … }"
#   ])
#
# A boot line that fails ends the session before it starts.
#
# Tey does not tell a program where its dependencies are, so the REPL's
# `--source-root`s are found here the way Tey finds them: the application's
# own sources, then each package in tey.lock — from package.local.kex when
# it is overridden there, from Tey's cache otherwise. And Tey runs a command
# with its input piped, not on the terminal, so the session has no history
# or line editing. Both go when Tey can start a REPL itself.
module Metro.Console

# Starts the REPL in the application at the working directory, booted
# with `boot`; its exit status when it ends.
opened : [String] -> Result<Integer, String>
foul opened(boot) do
  let roots = sourceRoots(FS.Directory.current).try
  let arguments = [
    ...roots.flatMap { |root| ["--source-root", root] },
    ...boot.flatMap { |line| ["-e", line] }
  ]
  return Process.stream(ENV.get("KEX").or("kex"), arguments)
end

# The directories the application at `root` and its dependencies resolve
# modules from, its own first.
sourceRoots : String -> Result<[String], String>
foul sourceRoots(root) do
  let text = match FS.File.read(FS.Path.join(root, "tey.lock")) do
    Ok(read) => read
    Error(_) => return Error("no tey.lock in ${root}; run `tey install`")
  end
  let lock : {String: Any} = match JSON.parse(text) do
    Ok(parsed) => parsed
    Error(_) => return Error("tey.lock is not JSON")
  end
  let packages : {String: Any} = lock.get("packages").or({})
  let overrides = overridden(root)
  let dependencies = packages.entries
    .filter { |_, locked| field(locked, "source") != "workspace" }
    .map { |name, locked| overrides.get(name).or(cached(locked)) }
  return Ok([sources(root), ...dependencies.map { |path| sources(path) }])
end

private do
  # A package's module directory: the package itself when its package.kex
  # names the folders at its top (`sources([...])`), `src` otherwise.
  sources : String -> String
  foul sources(package) do
    let manifest = FS.File.read(FS.Path.join(package, "package.kex")).or("")
    let named = manifest.lines.any? { |line| line.trim.startsWith?("sources(") }
    return named then package else FS.Path.join(package, "src")
  end

  # Where Tey keeps a locked package: a Git checkout by commit, or a
  # snapshot of a path dependency by its hash.
  cached : Any -> String
  foul cached(locked) do
    let cache = ENV.get("TEY_CACHE").or("${ENV.get("HOME").or(".")}/.cache/tey")
    if field(locked, "source") == "path"
      return "${cache}/snapshots/${field(locked, "sha256")}"
    end
    let checkout = "${cache}/src/${Digest.sha256(field(locked, "git"))}/${field(locked, "commit")}"
    let subdir = field(locked, "subdir")
    return subdir.empty? || subdir == "." then checkout else FS.Path.join(checkout, subdir)
  end

  # package.local.kex's `local("name", path: "…")` lines, by name, with
  # each path made absolute against `root`.
  overridden : String -> {String: String}
  foul overridden(root) do
    let text = FS.File.read(FS.Path.join(root, "package.local.kex")).or("")
    return text.lines
      .map { |line| line.trim }
      .filter { |line| line.startsWith?("local(") }
      .reduce({}) do |found, line|
        match line.split("\"") do
          [_, name, _, path | _] => found.put(name, absolute(root, path))
          _ => found
        end
      end
  end

  absolute : String -> String -> String
  let absolute(root, path) = path.startsWith?("/") then path else FS.Path.join(root, path)

  field : Any -> String -> String
  let field(locked, name) do
    let fields : {String: Any} = locked
    return fields.get(name).map { |value| "${value}" }.or("")
  end
end
