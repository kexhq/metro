# Password hashing: PBKDF2-HMAC-SHA256 with a random salt per password, from
# Erlang's `crypto`. A stored password is one line of text,
#
#   pbkdf2-sha256$600000$<salt, hex>$<derived key, hex>
#
# carrying its own parameters, so the work factor can be raised later without
# invalidating what is already stored.
#
# Kex has no crypto module yet (kexhq/kex#459); this is the userland wrapper
# the web-stack plan says to build in a package first.
module Metro.Auth.Password

# The OWASP-recommended count for PBKDF2-HMAC-SHA256.
let ITERATIONS = 600000

let SCHEME = "pbkdf2-sha256"

# The line to store for a password. Different every time: the salt is random.
hashed : String -> String
foul hashed(password) do
  let salt = BEAM.crypto.strong_rand_bytes(16)
  [SCHEME, "${ITERATIONS}", hex(salt), hex(derived(password, salt, ITERATIONS))].join("$")
end

# Whether `password` is the one a stored line was made from. A line that does
# not parse matches nothing. The comparison takes the same time wherever the
# first difference is.
matches? : String -> String -> Bool
foul matches?(password, stored) do
  match stored.split("$") do
    [scheme, rounds, salt, key] => do
      let iterations = rounds.to(Integer).or(0)
      return false if scheme != SCHEME || iterations <= 0

      return BEAM.crypto.hash_equals(derived(password, BEAM.binary.decode_hex(salt), iterations), BEAM.binary.decode_hex(key)) == true
    end
    _ => false
  end
end

# Does the work of checking a password and throws the answer away. For the
# sign-in of an email nobody registered, so that it takes as long as a wrong
# password does and the difference tells nobody which emails exist.
foul wasted(password: String) -> Void do
  derived(password, "0123456789abcdef", ITERATIONS)
  return ()
end

private do
  foul derived(password: String, salt: Any, iterations: Integer) -> Any do
    return BEAM.crypto.pbkdf2_hmac(:sha256, password, salt, iterations, 32)
  end

  foul hex(bytes: Any) -> String do
    return "${BEAM.binary.encode_hex(bytes)}"
  end
end
